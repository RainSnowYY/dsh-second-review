{
  "name": "dsh-second-review",
  "version": "1.3.1",
  "description": "二次评审：每条回复下面挂一张独立的副模型评审卡。让一个模型干活、另一个模型检查，结果挂在原回复下面，不重复回答、不抢占主模型。",
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "license": "MIT",
  "author": "RainSnowYY",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "second-opinion",
    "review",
    "multi-model"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/icon.png",
    "assets/card-preview.png",
    "test/core.test.mjs",
    "test/client.smoke.mjs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
